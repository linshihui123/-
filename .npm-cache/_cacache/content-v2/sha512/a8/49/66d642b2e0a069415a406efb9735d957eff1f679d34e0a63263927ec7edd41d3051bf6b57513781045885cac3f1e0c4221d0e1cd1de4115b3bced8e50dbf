cel(event.target.File[0]);\n            /*\n             * code 判断码\n             * info 导入成功信息\n             * data 导入成功数据\n            */\n        }\n    }\n    /**\n     * 导出Excel文件\n     * @param {data}  数据\n     * @param {sheetHeader}  表格头部\n     * @param {fileName}  文件命名\n     * @return {Stream} 文件流\n     */\n    this.$utils.exportExcel({\n      data: [{ 测试: \"123\" }],\n      sheetHeader: [\"测试\"],\n      fileName: \"文件名\",\n    });\n    ```\n\n-   ##### 其他方法\n\n    ```js\n    /**\n     * 保存文件\n     * @param {href} String 下载地址\n     * @param {fileName} String 保存文件名字\n     * @return {void}\n     */\n    this.$utils.fileSaveAs(href, fileName);\n    /**\n     * 打开外部链接\n     * @param {href} String 外链地址\n     * @return {void}\n     */\n    this.$utils.openExternalUrl(href);\n    ```\n\n### 更新日志\n\n| 版本号 | 更新内容                                  |\n| ------ | ----------------------------------------- |\n| 3.0.1  | 修复已知问题                              |\n| 3.0.2  | 修复已知问题和新增导入普通 Excel 文件数据 |\n| 3.0.3  | 引入 webpack 进行代码压缩                 |\n| 3.0.4  | 文档补充                                 |\n","readmeFilename":"README.md","gitHead":"27b39c0e489811b727c55dd9c75edaf4908f1291","_id":"@lesso/utils@3.0.4","_nodeVersion":"10.16.3","_npmVersion":"6.9.0","_npmUser":{"name":"deployment","email":"lesso.soft@lesso.com"},"maintainers":[{"name":"deployment","email":"lesso.soft@lesso.com"}],"dist":{"integrity":"sha512-6ybUrHH6Ke+MqI0zcnCMOe3nrcuf/e85upjxBqryS+9fJTQh8lKW3xWvc+49fnapDMJgaUEypGY17x0nWiTAiQ==","shasum":"e203345e27df2a9a6de5b52a3c295342ed74207c","tarball":"http://nexus.lesso.com/nexus/content/groups/npm/@lesso/utils/-/utils-3.0.4.tgz"}}},"name":"@lesso/utils","description":"联塑工具包","readme":"## @lesso/utils 文档\n\n```bash\nnpm install @lesso/utils@3.0.4 -S\n```\n\n### 方法汇总\n\n<!-- - ##### 加解密方法\n\n  ```js\n  // 挂载Vue全局\n  /**\n   * 加密\n   * @param {word} String 需加密字符串\n   * @param {keyStr} String 私钥\n   * @return {String} 加密后字符串\n   */\n  this.$utils.encrypt(word, keyStr);\n