:|:-----------:|\r\n|url|（必选）api地址|String|-|-|\r\n|data|（必选）请求参数|Object|-|-|\r\n\r\n---\r\n\r\n## 更新说明\r\n- 2.5.5: http 返回-21时跳转登录页\r\n- 2.5.4: 加入CancelToken开关\r\n- 2.5.3: 修正systemId传入问题\r\n- 2.5.2: 提交canceltoken方法\r\n- 2.5.0: 加入 responseDataHandler 做数据解密，构造请求头新的用户 token\r\n- 2.4.2: 增加额外请求头参数项\r\n- 2.4.1: 增加 jsonp 请求方法\r\n- 2.4.0: 修正踢线回调重复触发问题\r\n- 2.0.0: 修正调用http方法创建多个axios响应拦截实例的问题\r\n","readmeFilename":"README.md","gitHead":"6af5ea8d18bee0247e5b07e0523d0d3e4e19ef83","_id":"@lesso/common-http@2.5.5","_npmVersion":"5.6.0","_nodeVersion":"8.11.2","_npmUser":{"name":"deployment","email":"lesso.soft@lesso.com"},"maintainers":[{"name":"deployment","email":"lesso.soft@lesso.com"}],"dist":{"integrity":"sha512-fLoJFoyogJCUYrCLvynERXWdGqbzPigpLV3F0I8Fdoz+VzLlWnro44uuZk59dRUBKHeMAbB4E1loQ/n8stJbfQ==","shasum":"7ec7c97c4dc9a6770fba23e05ccdb83f01cb0144","tarball":"http://nexus.lesso.com/nexus/content/groups/npm/@lesso/common-http/-/common-http-2.5.5.tgz"}},"2.5.6":{"name":"@lesso/common-http","description":"lesso common http","version":"2.5.6","author":{"name":"Deployment","email":"lesso.soft@lesso.com"},"license":"ISC","main":"dist/index.js","private":false,"scripts":{"dev":"cross-env NODE_ENV=development webpack-dev-server --open --hot","build":"cross-env NODE_ENV=production webpack --progress --hide-modules","prepare":"npm run build"},"dependencies":{"axios":"0.18.0","lodash":"4.17.15","jsonp":"0.2.1"},"browserslist":["> 1%","last 2 versions","not ie <= 8"],"devDependencies":{"babel-core":"6.26.0","babel-loader":"7.1.2","babel-plugin-transform-runtime":"6.23.0","babel-preset-env":"1.6.0","babel-preset-stage-3":"6.24.1","cross-env":"5.0.5","css-loader":"0.28.7","file-loader":"1.1.4","vue-loader":"13.0.5","vue-template-compiler":"2.4.4","webpack":"3.6.0","webpack-dev-server":"2.9.1"},"publishConfig":{"registry":"http://nexus.lesso.com/nexus/content/repositories/npm-internal/"},"repository":{"type":"git","url":"http://gitlab.lesso.com/npm-internal/lesso-common-http.git"},"rea