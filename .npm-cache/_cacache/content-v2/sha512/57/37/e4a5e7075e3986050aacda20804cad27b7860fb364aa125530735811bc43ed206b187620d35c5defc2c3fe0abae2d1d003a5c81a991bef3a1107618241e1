"1.6.0","babel-preset-stage-3":"6.24.1","cross-env":"5.0.5","css-loader":"0.28.7","file-loader":"1.1.4","vue-loader":"13.0.5","vue-template-compiler":"2.4.4","webpack":"3.6.0","webpack-dev-server":"2.9.1"},"publishConfig":{"registry":"http://nexus.lesso.com/nexus/content/repositories/npm-internal/"},"repository":{"type":"git","url":"http://gitlab.lesso.com/npm-internal/lesso-common-http.git"},"readme":"# lesso-common http请求方法\r\n\r\n## 安装\r\n```bash\r\nnpm install @lesso/common-http\r\n```\r\n\r\n## http 使用方法\r\n\r\n```javascript\r\nimport { http } from '@lesso/common-http';\r\nimport { getStorage, saveStorage, removeStorage } from 'lesso-common/public/utils';\r\nimport env from './env';\r\nimport constant from '@/public/constant';\r\nimport router from '@/router';\r\nimport sendMain from \"lesso-common/event/ipcRenderer\";\r\nimport { MessageBox } from \"element-ui\"\r\n\r\n/**\r\n * url: 地址\r\n * method: 请求方法\r\n * params: 参数\r\n * timeout: 超时时间\r\n * isOriginalGET: 是否传统get传参\r\n */\r\n\r\n// 退出登录回调\r\nconst logoutCallback = (info) => {\r\n    const goLogin = () => {\r\n        // 清除用户数据\r\n        removeStorage('userData')\r\n    \r\n        if(constant.isElectron){\r\n            // 返回 Electorn 窗口\r\n            sendMain(\"openLoginWin\");\r\n        }else{\r\n            // 跳转登录页\r\n            router.push(\"/login\");\r\n        }\r\n    }\r\n\r\n    MessageBox.alert(info, {\r\n        showClose: false,\r\n        confirmButtonText: \"确定\",\r\n        customClass: \"alertFailure\",\r\n        callback: () => {\r\n            goLogin();\r\n        }\r\n    });\r\n} \r\n\r\n// 更换 token 回调\r\nconst changeJwtCallback = (jwt) => {\r\n    let userData = getStorage('userData');\r\n    userData.jwt = jwt;\r\n    saveStorage('userData', userData);\r\n}\r\n\r\n// 接口无权限回调\r\nconst noAuthCallback = (info) => {\r\n    MessageBox.alert(info, {\r\n        showClose: false,\r\n        confirmButtonText: \"确定\",\r\n        customClass: \"alertFailure\",\r\n    });\r\n}\r\n\r\nconst req = ({ baseUrl, method, url, params, timeout, isOriginalGET, isLogin }) => {\r\n    let options={\r\n        url: env[baseUrl] + url,\r\n        method: method, \r\n        params: params, \r\n        timeout: timeout, \r\n        isOriginalGET: isOriginalGET, \r\n        systemId: constant.systemId,\r\n        deviceId: window.fingerprint,\r\n        logoutCallback: logoutCallback,\r\n        changeJwtCallback: changeJwtCallback,\r\n        noAuthCallback: noAuthCallback\r\n    };\r\n\r\n    // 非登录接口加鉴权\r\n    if(!isLogin) {\r\n        let userData = getStorage('userData');\r\n        options.jwt = userData.jwt;\r\n        options.userId = userData.user.id;\r\n    }\r\n    return http(options);\r\n}\r\n\r\nexport default req;\r\n```\r\n\r\n## 参数说明\r\n\r\n|参数|说明|类型|默认值|备注|\r\n|---|:----: |:----:|:-------:|:-----------:|\r\n|url|（必选）api地址|String|-|-|\r\n|method|（必选）请求方法|String|- |get/post/put/delete|\r\n|params|（必选）请求参数|Object|-|-|\r\n|timeout|超时时间|Number|20000|-|\r\n|isOriginalGET|是否传统get传参|Boolean|false|使用url/?xxx=yyy的方法传参|\r\n|systemId|系统id|Number|-|systemId与“微服务管理平台”上的一致，用于兼容权限1.0|\r\n|device|设备类型|String|'PC'|选填值：APP/PC/IPC|\r\n|deviceId|（必选）设备编码|String|-|浏览器指纹值|\r\n|jwt|（必选）鉴权 token|String|-|-|\r\n|userId|（必选）用户id |String|-|-|\r\n|logoutCallback|（必选）登出回调 |Function|-|function(info) 回调提示显示info内容|\r\n|changeJwtCallback|（必选）换jwt回调 |Function|-|-|\r\n|noAuthCallback|（必选）无权限访问回调|Function|-|function(info) 回调提示显示info内容|\r\n|responseType|响应数据类型|String|-|默认响应数据类型为json|\r\n|extraConfig|其他 axios 配置项|Object|-|-|\r\n|errorHandler|异常处理操作，用于上报到 Sentry|Function|-|function(error) 回调上报error到sentry|\r\n|extraHeaders|额外请求头参数项|Object|-|-|\r\n|responseDataHandler|响应数据处理方法|Function|-|function(response){ ... return response}| \r\n|authCode|（必选）新版权限系统租户编码对象|Object|-|code 客户端编码, tcode租户编码, 示例:{code:\"auth-admin\",tcode:\"platform-group\"}, |\r\n|useCancelToken|是否使用CancelToken|Boolean|false|使用cancelToken拦截重复请求 |\r\n\r\n---\r\n\r\n## jsonp 使用方法\r\n\r\n```javascript\r\nimport { jsonp } from '@lesso/common-http';\r\n\r\njsonp(url, data)\r\n    .then(res => {\r\n\r\n    })\r\n    .catch(err => {\r\n\r\n    })\r\n```\r\n\r\n## 参数说明\r\n\r\n|参数|说明|类型|默认值|备注|\r\n|---|:----: |:----:|:-------:|:-----------:|\r\n|url|（必选）api地址|String|-|-|\r\n|data|（必选）请求参数|Object|-|-|\r\n\r\n---\r\n\r\n## 更新说明\r\n- 2.5.8: 处理第三方代理的temptoken过期更换问题\r\n- 2.5.7: 处理第三方代理的temptoken携带问题\r\n- 2.5.6: 修正userId与jwt传入判断\r\n- 2.5.5: http 返回-21时跳转登录页\r\n- 2.5.4: 加入CancelToken开关\r\n- 2.5.3: 修正systemId传入问题\r\n- 2.5.2: 提交canceltoken方法\r\n- 2.5.0: 加入 responseDataHandler 做数据解密，构造请求头新的用户 token\r\n- 2.4.2: 增加额外请求头参数项\r\n- 2.4.1: 增加 jsonp 请求方法\r\n- 2.4.0: 修正踢线回调重复触发问题\r\n- 2.0.0: 修正调用http方法创建多个axios响应拦截实例的问题\r\n","readmeFilename":"README.md","gitHead":"1e46e36d570c62b624064e7a77ec0df68b41c3aa","_id":"@lesso/common-http@2.5.9-beta.1","_nodeVersion":"10.16.3","_npmVersion":"6.9.0","_npmUser":{"name":"deployment","email":"lesso.soft@lesso.com"},"maintainers":[{"name":"deployment","email":"lesso.soft@lesso.com"}],"dist":{"integrity":"sha512-lFEWOo8a+XK02RB7TRc7Dv4nRk3UKCQ/jZ5Zmn1MlzYDZSwgRvRhfvQWyyF7WJDSYUz6ZPFxPrT6f3u8oSi1TA==","shasum":"2108f1546ade9a0bb51472036b43d1cb8d2bdf76","tarball":"http://nexus.lesso.com/nexus/content/groups/npm/@lesso/common-http/-/common-http-2.5.9-beta.1.tgz"}},"3.0.6-beta.5":{"name":"@lesso/common-http","description":"lesso common http","version":"3.0.6-beta.5","author":{"name":"Deployment","email":"lesso.soft@lesso.com"},"license":"ISC","main":"dist/index.js","private":false,"scripts":{"dev":"ebpack-dev-server --open --hot","build":"webpack --progress --hide-modules","lint":"eslint src","prettier":"prettier --write src"},"dependencies":{"axios":"0.18.0","jsonp":"0.2.1","lodash":"4.17.15"},"browserslist":["> 1%","last 2 versions","not ie <= 8"],"devDependencies":{"babel-core":"6.26.0","babel-loader":"7.1.2","babel-plugin-transform-runtime":"6.23.0","babel-preset-env":"1.6.0","babel-preset-stage-3":"6.24.1","cross-env":"5.0.5","css-loader":"0.28.7","eslint":"^7.19.0","