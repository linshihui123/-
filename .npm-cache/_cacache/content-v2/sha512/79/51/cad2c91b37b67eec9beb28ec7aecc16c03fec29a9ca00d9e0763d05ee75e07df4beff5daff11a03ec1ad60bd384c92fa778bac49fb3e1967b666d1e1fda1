\r\n<script>\r\n  import websocketClient from \"@lesso/common-websocket\";\r\n\r\n  export default {\r\n    data() {\r\n      return {\r\n        wsClient: \"\",\r\n      };\r\n    },\r\n    created() {\r\n      this.initWebsocket();\r\n    },\r\n    methods: {\r\n      initWebsocket() {\r\n        const goLogin = () => {\r\n          if (this.$constant.isElectron) {\r\n            sendMain(\"openLoginWin\");\r\n          } else {\r\n            this.$router.push(\"/login\");\r\n          }\r\n        };\r\n\r\n        // 广播通知回调\r\n        const fanoutCallback = msg => {\r\n          let res = JSON.parse(msg.body);\r\n          console.log(\"ws res:\", msg);\r\n          this.$notify({\r\n            title: `系统通知`,\r\n            message: res.message,\r\n            type: \"warning\",\r\n            duration: 0,\r\n            position: \"bottom-right\",\r\n          });\r\n        };\r\n\r\n        // 定向通知回调\r\n        const topicCallback = msg => {\r\n          let res = JSON.parse(msg.body);\r\n          console.log(\"ws res:\", msg);\r\n          this.$notify({\r\n            title: `来自${res.userName}的通知`,\r\n            message: res.message,\r\n            type: \"warning\",\r\n            duration: 0,\r\n            position: \"bottom-right\",\r\n          });\r\n        };\r\n\r\n        // 踢线通知回调\r\n        const logoutCallback = forceOffline => {\r\n          if (forceOffline) {\r\n            this.$alert(\"帐号已被强制下线\", {\r\n              showClose: false,\r\n              confirmButtonText: \"确定\",\r\n              customClass: \"alertPrompt\",\r\n            }).then(() => {\r\n              this.$http\r\n                .userLogout({\r\n                  uid: constant.userId,\r\n                  systemId: constant.systemId,\r\n                })\r\n                .then(res => {\r\n                  goLogin();\r\n                })\r\n                .catch(err => {\r\n                  goLogin();\r\n                });\r\n            });\r\n          } else {\r\n            this.$alert(\"帐号已在别处登录\", {\r\n              showClose: false,\r\n              confirmButtonText: \"确定\",\r\n              customClass: \"alertPrompt\",\r\n            }).then(() => {\r\n              goLogin();\r\n            });\r\n          }\r\n        };\r\n\r\n        this.wsClient = new websocketClient({\r\n          systemEnv: constant.appenv,\r\n          userId: this.$constant.user.id,\r\n          // 升级到权限 2.0 之后改成\r\n          // systemCode: this.$constant.authCode.code\r\n          systemCode: \"mes\",\r\n          loginTimestamp: this.$constant.timestamp,\r\n          fanoutCallback: fanoutCallback,\r\n          topicCallback: topicCallback,\r\n          logoutCallback: logoutCallback,\r\n        });\r\n\r\n        this.wsClient.connect();\r\n        // 创建Websocket实例后需要需要在销毁前断开连接\r\n        this.$on(\"hook:beforeDestroy\", () => {\r\n          this.wsClient.disconnect();\r\n        });\r\n      },\r\n    },\r\n  };\r\n</script>\r\n```\r\n\r\n### 大屏事例\r\n\r\n```html\r\n<script>\r\nimport env from \"@/api/env\";\r\nimport websocketClient from \"@lesso/common-websocket\";\r\nexport default {\t\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\twsClient: null,\t\r\n\t\t};\r\n\t},\r\n\tcreated() {\r\n\t\tthis.initWebsocket();\r\n\t},\r\n\tmethods: {\r\n\t\tinitWebsocket() {\r\n\t\t\t// 广播通知回调\r\n\t\t\tconst fanoutCallback = msg => {\r\n\t\t\t\tlet res = JSON.parse(msg.body);\r\n\t\t\t\tconsole.log(\"fanoutCallback res:\", res);\r\n\t\t\t};\r\n\r\n\t\t\t// 定向通知回调\r\n\t\t\tconst topicCallback = msg => {\r\n\t\t\t\tlet res = JSON.parse(msg.body);\r\n\t\t\t\tconsole.log(\"topicCallback res:\", res);\r\n\t\t\t};\r\n\r\n\t\t\tthis.wsClient = new websocketClient({\r\n                // 传入 [websocket地址] -> rabbitMQ 地址\r\n\t\t\t\twebsocketUrl: env.websocket,\r\n                // 传入 [当前环境变量]\r\n\t\t\t\tsystemEnv: \"dev\",\r\n                // 传入 [交换机名称] -> [exchange]\r\n\t\t\t\tuserId: \"pv.bigScreen.data\",\r\n                // 传入 [队列名称] -> [queues]\r\n\t\t\t\tsystemCode: \"pv.direct\",\r\n\t\t\t\tloginTimestamp: new Date().getTime(),\r\n\t\t\t\tfanoutCallback: fanoutCallback,\r\n\t\t\t\ttopicCallback: topicCallback\r\n\t\t\t});\r\n\r\n\t\t\tthis.wsClient.connect();\r\n\t\t\t// 创建Websocket实例后需要需要在销毁前断开连接\r\n\t\t\tthis.$on(\"hook:beforeDestroy\", () => {\r\n\t\t\t\tthis.wsClient.disconnect();\r\n\t\t\t});\r\n\t\t},\r\n\t},\r\n};\r\n</script>\r\n```\r\n\r\n## 参数说明\r\n\r\n| 参数           |     说明     |   类型   | 默认值 | 必填  | 备注                                                         |\r\n| -------------- | :----------: | :------: | :----: | :---: | ------------------------------------------------------------ |\r\n| systemEnv      |   系统环境   |  String  |   -    | true  | app/uat/dev                                                  |\r\n| websocketUrl   | 消息通知地址 |  String  |   -    | true  | 传入的 mq 地址                                               |\r\n| authUrl        | 权限系统地址 |  String  |   -    | false | 传入的权限系统地址                                           |\r\n| userId         |   用户 id    |  String  |   -    | true  | 使用登录信息返回的 userId                                    |\r\n| systemCode     |   系统编码   |  String  |   -    | true  | -                                                            |\r\n| loginTimestamp |  登录时间戳  |  number  |   -    |       | -                                                            |\r\n| loginInfo      | MQ 登录信息  |  Object  |   -    | false | 传入的登录信息，用于覆盖默认值。格式：`{username: 'guest', password: 'guest'}` |\r\n| debugMode      |   调试模式   | Boolean  | false  | false | 控制台输出调试信息                                           |\r\n| fanoutCallback | 广播消息回调 | Function |   -    | true  | (msg)=>{} msg 服务端返回信息对象                             |\r\n| topicCallback  | 定向消息回调 | Function |   -    | true  | (msg)=>{} msg 服务端返回信息对象                             |\r\n| logoutCallback | 登出消息回调 | Function |   -    | true  | (msg)=>{} msg 服务端返回信息对象                             |\r\n\r\n## 更新日志\r\n\r\n| 版本号 | 更新内容      