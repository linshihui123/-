通知回调\r\n            const fanoutCallback = msg => {\r\n                let res = JSON.parse(msg.body);\r\n                console.log('ws res:', msg)\r\n                this.$notify({\r\n                    title: `系统通知`,\r\n                    message: res.message,\r\n                    type: \"warning\",\r\n                    duration: 0,\r\n                    position: \"bottom-right\"\r\n                });\r\n            };\r\n\r\n            // 定向通知回调\r\n            const topicCallback = msg => {\r\n                let res = JSON.parse(msg.body);\r\n                console.log('ws res:', msg)\r\n                this.$notify({\r\n                    title: `来自${res.userName}的通知`,\r\n                    message: res.message,\r\n                    type: \"warning\",\r\n                    duration: 0,\r\n                    position: \"bottom-right\"\r\n                });\r\n            };\r\n\r\n            // 踢线通知回调\r\n            const logoutCallback = forceOffline => {\r\n                if(forceOffline) {\r\n                    this.$alert(\"帐号已被强制下线\", {\r\n                        showClose: false,\r\n                        confirmButtonText: \"确定\",\r\n                        customClass: \"alertPrompt\"\r\n                    }).then(() => {\r\n                        this.$http.userLogout({\r\n                            uid: constant.userId,\r\n                            systemId: constant.systemId\r\n                        }).then((res) => {\r\n                            goLogin()\r\n                        }).catch((err) => {\r\n                            goLogin()\r\n                        });\r\n                    })\r\n                } else {\r\n                    this.$alert(\"帐号已在别处登录\", {\r\n                        showClose: false,\r\n                        confirmButtonText: \"确定\",\r\n                        customClass: \"alertPrompt\"\r\n                    }).then(() => {\r\n                        goLogin()\r\n                    })\r\n                }\r\n            };\r\n\r\n            this.wsClient = new websocketClient({\r\n                systemEnv: constant.appenv,\r\n                userId: this.$constant.user.id, \r\n                // 升级到权限 2.0 之后改成 \r\n                // systemCode: this.$constant.authCode.code\r\n                systemCode: 'mes', \r\n                loginTimestamp: this.$constant.timestamp,\r\n                fanoutCallback: fanoutCallback,\r\n                topicCallback: topicCallback,\r\n                logoutCallback: logoutCallback,\r\n            });\r\n\r\n            this.wsClient.connect();\r\n        }\r\n    }\r\n}\r\n\r\n</script>\r\n```\r\n\r\n## 参数说明\r\n|参数|说明|类型|默认值|备注|\r\n|---|:----: |:----:|:-------:|:-----------:|\r\n|systemEnv|系统环境|String|-|app/qas/dev|\r\n|websocketUrl|消息通知地址|String|-|传入的mq地址，用于覆盖默认值|\r\n|authUrl|权限系统地址|String|-|传入的权限系统地址，用于覆盖默认值|\r\n|userId|用户id|String|- |使用登录信息返回的userId|\r\n|systemCode|系统编码|String|-|-|\r\n|loginTimestamp|登录时间戳|number|-|-|\r\n|loginInfo|MQ登录信息|Object|-|传入的登录信息，用于覆盖默认值。格式：`{username: 'guest', password: 'guest'}`|\r\n|debugMode|调试模式|Boolean|false|控制台输出调试信息|\r\n|fanoutCallback|广播消息回调|Function|-|(msg)=>{} msg服务端返回信息对象|\r\n|topicCallback|定向消息回调|Function|-|(msg)=>{} msg服务端返回信息对象|\r\n|logoutCallback|登出消息回调|Function|-|(forceOffline)=>{} forceOffline是否强制下线，为true时需要调用登出接口|\r\n\r\n\r\n### 版本说明\r\n- 2.0.0：更新@stomp/stompjs@5.4.2，断线判断状态码重连","readmeFilename":"README.md","gitHead":"c2383b7828a3b7d769ed225981fe1ef9577bd2db","_id":"@lesso/common-websocket@2.0.0","_npmVersion":"5.6.0","_nodeVersion":"8.11.2","_npmUser":{"name":"deployment","email":"lesso.soft@lesso.com"},"maintainers":[{"name":"deployment","email":"lesso.soft@lesso.com"}],"dist":{"integrity":"sha512-ycPQUAfWoN9go/O3Hl52vL+PFKsjblMBLFPn1znbZMQzgjZLNiCatSOr1vZvoDIQarn/BN4AGzETyHa6k+zs2A==","shasum":"f43e1a39d8ca9977438de9d72abcf89685d680e7","tarball":"http://nexus.lesso.com/nexus/content/groups/npm/@lesso/common-websocket/-/common-websocket-2.0.0.tgz"}}